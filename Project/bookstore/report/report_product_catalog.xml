<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ========================================== -->
    <!-- PRODUCT CATALOG PDF REPORT -->
    <!-- ========================================== -->

    <!-- Report Action for Product Catalog -->
    <record id="action_report_product_catalog" model="ir.actions.report">
        <field name="name">Product Catalog</field>
        <field name="model">bookstore.product</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bookstore.report_product_catalog_template</field>
        <field name="report_file">bookstore.report_product_catalog_template</field>
        <field name="print_report_name">'Product_Catalog'</field>
        <field name="binding_model_id" ref="model_bookstore_product"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Product Catalog Report Template -->
    <template id="report_product_catalog_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <!-- Header -->
                    <div class="text-center mb-4">
                        <h2>Product Catalog</h2>
                        <p class="text-muted">Complete list of available products</p>
                    </div>

                    <!-- Products Table -->
                    <table class="table table-striped table-bordered">
                        <thead>
                            <tr class="bg-primary text-white">
                                <th>#</th>
                                <th>Product Name</th>
                                <th>Type</th>
                                <th class="text-right">Purchase Price</th>
                                <th class="text-right">Sell Price</th>
                                <th class="text-right">In Stock</th>
                                <th>Categories</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="doc">
                                <tr>
                                    <td><t t-esc="doc_index + 1"/></td>
                                    <td>
                                        <strong><t t-esc="doc.product"/></strong>
                                        <t t-if="doc.is_membership">
                                            <span class="badge badge-warning">Membership</span>
                                        </t>
                                    </td>
                                    <td>
                                        <t t-if="doc.type == 'product'">
                                            <span class="badge badge-primary">Storable</span>
                                        </t>
                                        <t t-else="">
                                            <span class="badge badge-info">Service</span>
                                        </t>
                                    </td>
                                    <td class="text-right"><t t-esc="'%.2f' % doc.purchase_price"/> Lek</td>
                                    <td class="text-right"><t t-esc="'%.2f' % doc.sell_price"/> Lek</td>
                                    <td class="text-right">
                                        <t t-if="doc.type == 'product'">
                                            <t t-if="doc.quantity > 10">
                                                <span class="text-success"><t t-esc="'%.0f' % doc.quantity"/></span>
                                            </t>
                                            <t t-elif="doc.quantity > 0">
                                                <span class="text-warning"><t t-esc="'%.0f' % doc.quantity"/></span>
                                            </t>
                                            <t t-else="">
                                                <span class="text-danger">Out of Stock</span>
                                            </t>
                                        </t>
                                        <t t-else="">
                                            <span class="text-muted">N/A</span>
                                        </t>
                                    </td>
                                    <td>
                                        <t t-foreach="doc.category_ids" t-as="cat">
                                            <span class="badge badge-secondary"><t t-esc="cat.category"/></span>
                                        </t>
                                    </td>
                                </tr>
                                <!-- Show membership details if applicable -->
                                <t t-if="doc.is_membership">
                                    <tr class="bg-light">
                                        <td></td>
                                        <td colspan="6" class="text-muted small">
                                            <em>Membership Duration: <t t-esc="doc.membership_days"/> days</em>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>

                    <!-- Summary -->
                    <div class="row mt-4">
                        <div class="col-6">
                            <table class="table table-bordered">
                                <tr>
                                    <td><strong>Total Products:</strong></td>
                                    <td><t t-esc="len(docs)"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Storable Products:</strong></td>
                                    <td><t t-esc="len([d for d in docs if d.type == 'product'])"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Service Products:</strong></td>
                                    <td><t t-esc="len([d for d in docs if d.type == 'service'])"/></td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <!-- Footer -->
                    <div class="row mt-5">
                        <div class="col-12 text-center text-muted">
                            <small>Catalog generated on <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M')"/></small>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
