<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ========================================== -->
    <!-- SALES STATISTICS REPORT -->
    <!-- ========================================== -->

    <!-- Report Action for Sales Statistics -->
    <record id="action_report_sales_statistics" model="ir.actions.report">
        <field name="name">Sales Statistics Report</field>
        <field name="model">bookstore.sales.statistics.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bookstore.report_sales_statistics_template</field>
        <field name="report_file">bookstore.report_sales_statistics_template</field>
        <field name="print_report_name">'Sales_Statistics_%s_%s' % (object.date_from, object.date_to)</field>
    </record>

    <!-- Sales Statistics Report Template -->
    <template id="report_sales_statistics_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 class="text-center">Sales Statistics Report</h2>

                    <!-- Date Range Header -->
                    <div class="row mt-4 mb-4">
                        <div class="col-12 text-center">
                            <h4>
                                Period: <t t-esc="doc.date_from"/> to <t t-esc="doc.date_to"/>
                            </h4>
                        </div>
                    </div>

                    <!-- Summary Statistics -->
                    <t t-set="data" t-value="doc._get_report_data()"/>

                    <div class="row">
                        <div class="col-6">
                            <table class="table table-bordered">
                                <thead>
                                    <tr class="bg-primary text-white">
                                        <th colspan="2" class="text-center">Summary Statistics</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><strong>Total Transactions</strong></td>
                                        <td class="text-right"><t t-esc="data['total_transactions']"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Total Sales</strong></td>
                                        <td class="text-right"><t t-esc="'%.2f' % data['total_sales']"/> Lek</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Total Purchases</strong></td>
                                        <td class="text-right"><t t-esc="'%.2f' % data['total_purchases']"/> Lek</td>
                                    </tr>
                                    <tr class="bg-success text-white">
                                        <td><strong>Net Profit</strong></td>
                                        <td class="text-right"><t t-esc="'%.2f' % data['profit']"/> Lek</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Top Selling Products -->
                    <h4 class="mt-4">Top Selling Products</h4>
                    <table class="table table-striped table-bordered">
                        <thead>
                            <tr class="bg-secondary text-white">
                                <th>#</th>
                                <th>Product Name</th>
                                <th class="text-right">Quantity Sold</th>
                                <th class="text-right">Total Revenue</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="data['top_products']" t-as="product">
                                <tr>
                                    <td><t t-esc="product_index + 1"/></td>
                                    <td><t t-esc="product[0]"/></td>
                                    <td class="text-right"><t t-esc="'%.2f' % product[1]['qty']"/></td>
                                    <td class="text-right"><t t-esc="'%.2f' % product[1]['total']"/> Lek</td>
                                </tr>
                            </t>
                            <t t-if="not data['top_products']">
                                <tr>
                                    <td colspan="4" class="text-center text-muted">No sales data available</td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <!-- Top Clients -->
                    <h4 class="mt-4">Top Clients by Spending</h4>
                    <table class="table table-striped table-bordered">
                        <thead>
                            <tr class="bg-secondary text-white">
                                <th>#</th>
                                <th>Client Name</th>
                                <th class="text-right">Total Spent</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="data['top_clients']" t-as="client">
                                <tr>
                                    <td><t t-esc="client_index + 1"/></td>
                                    <td><t t-esc="client[0]"/></td>
                                    <td class="text-right"><t t-esc="'%.2f' % client[1]"/> Lek</td>
                                </tr>
                            </t>
                            <t t-if="not data['top_clients']">
                                <tr>
                                    <td colspan="3" class="text-center text-muted">No client data available</td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <!-- Invoice Details -->
                    <h4 class="mt-4">Invoice Details</h4>
                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr class="bg-secondary text-white">
                                <th>Invoice #</th>
                                <th>Date</th>
                                <th>Type</th>
                                <th>Client</th>
                                <th>Employee</th>
                                <th class="text-right">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="data['invoices']" t-as="invoice">
                                <tr>
                                    <td><t t-esc="invoice.invoice_code"/></td>
                                    <td><t t-esc="invoice.invoice_date"/></td>
                                    <td>
                                        <t t-if="invoice.invoice_type == 'out'">Sale</t>
                                        <t t-else="">Purchase</t>
                                    </td>
                                    <td><t t-esc="invoice.client_id.name or '-'"/></td>
                                    <td><t t-esc="invoice.employee_id.name or '-'"/></td>
                                    <td class="text-right"><t t-esc="'%.2f' % invoice.total"/> Lek</td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <!-- Footer -->
                    <div class="row mt-5">
                        <div class="col-12 text-center text-muted">
                            <small>Report generated on <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M')"/></small>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
