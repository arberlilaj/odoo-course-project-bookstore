<?xml version="1.0" encoding="utf-8"?><odoo>

    <!-- 1. TIER VIEW -->
    <record id="membership_tier_view_tree" model="ir.ui.view">
        <field name="name">bookstore.membership.tier.tree</field>
        <field name="model">bookstore.membership.tier</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
                <field name="price"/>
                <field name="description"/>
            </tree>
        </field>
    </record>

    <!-- 2. MEMBERSHIP FORM VIEW -->
    <record id="membership_view_form" model="ir.ui.view">
        <field name="name">bookstore.membership.form</field>
        <field name="model">bookstore.membership</field>
        <field name="arch" type="xml">
            <form string="Membership Subscription">
                <header>
                    <button name="action_confirm" string="Confirm &amp; Activate" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state != 'active'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="client_id" placeholder="Select Client..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="tier_id"/>
                            <field name="price"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="duration_months"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 3. MEMBERSHIP LIST VIEW -->
    <record id="membership_view_tree" model="ir.ui.view">
        <field name="name">bookstore.membership.tree</field>
        <field name="model">bookstore.membership</field>
        <field name="arch" type="xml">
            <tree string="Memberships">
                <field name="client_id"/>
                <field name="tier_id"/>
                <field name="duration_months"/>
                <field name="end_date"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-danger="state == 'expired'"/>
            </tree>
        </field>
    </record>

    <!-- 4. ACTIONS -->
    <record id="membership_tier_action" model="ir.actions.act_window">
        <field name="name">Membership Tiers</field>
        <field name="res_model">bookstore.membership.tier</field>
        <field name="view_mode">tree</field>
    </record>

    <record id="membership_subscription_action" model="ir.actions.act_window">
        <field name="name">Memberships</field>
        <field name="res_model">bookstore.membership</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
