<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sales Statistics Wizard Form View -->
    <record id="view_sales_statistics_wizard_form" model="ir.ui.view">
        <field name="name">bookstore.sales.statistics.wizard.form</field>
        <field name="model">bookstore.sales.statistics.wizard</field>
        <field name="arch" type="xml">
            <form string="Sales Statistics Report">
                <group>
                    <group string="Date Range">
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group string="Filters (Optional)">
                        <field name="invoice_type"/>
                        <field name="client_id"/>
                        <field name="employee_id"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_report"
                            string="Print Report"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_view_invoices"
                            string="View Invoices"
                            type="object"
                            class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open the wizard -->
    <record id="action_sales_statistics_wizard" model="ir.actions.act_window">
        <field name="name">Sales Statistics</field>
        <field name="res_model">bookstore.sales.statistics.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
